# Modo nuvem (Supabase). Sem estas variáveis o app roda no modo local (dados no navegador).
# Supabase → Project Settings → API: "Project URL" e a chave "anon / publishable" (é pública por design).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Login na nuvem: pin (padrão, sem e-mail) ou email
# VITE_AUTH_MODE=pin
